) => a.baseY - b.baseY);\n\n            drawRotatingCanopy(angleOffset);\n            backItems.forEach(item => drawHorseWithRider(item, item.index));\n            \n            drawBasePlatform();\n            drawCenterPillar();\n\n            frontItems.forEach(item => drawHorseWithRider(item, item.index));\n\n            angleOffset += 0.015;\n            requestAnimationFrame(animate);\n        }\n\n        animate();\n    <\/script>\n</body>\n</html>\n",

et seatRightY = seatCenterY + ropeOffsetY;\n\n            // Draw Ropes\n            ctx.strokeStyle = '#d97706';\n            ctx.lineWidth = 3.5;\n            \n            ctx.beginPath();\n            ctx.moveTo(anchorLeftX, topBarY);\n            ctx.lineTo(seatLeftX, seatLeftY);\n            ctx.stroke();\n\n            ctx.beginPath();\n            ctx.moveTo(anchorRightX, topBarY);\n            ctx.lineTo(seatRightX, seatRightY);\n            ctx.stroke();\n\n            // Draw Boy on Swing\n            ctx.save();\n            ctx.translate(seatCenterX, seatCenterY);\n            ctx.rotate(currentAngle);\n\n            // Swing Wooden Seat\n            ctx.fillStyle = '#b45309';\n            ctx.fillRect(-22, -4, 44, 8);\n\n            // Boy's Body (Torso)\n            ctx.fillStyle = '#dc2626'; \n            ctx.beginPath();\n            ctx.ellipse(-2, -28, 10, 16, -0.2, 0, Math.PI * 2);\n            ctx.fill();\n\n            // Legs extended forward/backward with motion\n            ctx.strokeStyle = '#1e3a8a'; \n            ctx.lineWidth = 6;\n            ctx.beginPath();\n            ctx.moveTo(-4, -14);\n            ctx.lineTo(12, -2);\n            ctx.lineTo(26, -4); \n            ctx.stroke();\n\n            // Shoes\n            ctx.fillStyle = '#451a03';\n            ctx.beginPath();\n            ctx.arc(28, -4, 4, 0, Math.PI * 2);\n            ctx.fill();\n\n            // Arms holding rope\n            ctx.strokeStyle = '#fcd34d';\n            ctx.lineWidth = 4;\n            ctx.beginPath();\n            ctx.moveTo(-4, -34);\n            ctx.lineTo(-14, -22);\n            ctx.stroke();\n\n            // Head\n            ctx.fillStyle = '#fcd34d';\n            ctx.beginPath();\n            ctx.arc(2, -48, 10, 0, Math.PI * 2);\n            ctx.fill();\n\n            // Hair & Glasses\n            ctx.fillStyle = '#292524';\n            ctx.beginPath();\n            ctx.arc(0, -51, 10, Math.PI * 0.8, Math.PI * 2.1);\n            ctx.fill();\n\